# Namibia Sports Platform — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.

# ===== DATABASE =====
# The Worker reaches Postgres through the HYPERDRIVE binding (see wrangler.jsonc),
# not DATABASE_URL. This value is still used by drizzle-kit migrations and as the
# Hyperdrive localConnectionString for `wrangler dev`.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ===== SUPABASE =====
# Server-side values are Worker vars/secrets — set with `wrangler secret put <NAME>`.
SUPABASE_URL=https://rbibqjgsnrueubrvyqps.supabase.co
VITE_SUPABASE_URL=https://rbibqjgsnrueubrvyqps.supabase.co
# Verifies caller JWTs and applies RLS as the caller. Required.
SUPABASE_ANON_KEY=
# Storage uploads only.
SUPABASE_SERVICE_ROLE_KEY=

# ===== AUTH =====
# Auth is Supabase Auth end to end: the client sends the Supabase access token as
# `Authorization: Bearer <token>` and the Worker verifies it. The former self-signed
# session JWT (JWT_SECRET / OAUTH_SERVER_URL / OWNER_OPEN_ID) has been removed.
# Roles live in sportsplatform_users.role; self-signup always yields 'user'.

# ===== AI =====
ANTHROPIC_API_KEY=

# ===== WHATSAPP =====
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# For Supabase Edge Function whatsapp-webhook (Meta verification)
WHATSAPP_VERIFY_TOKEN=sports-platform-verify

# ===== CLIENT (VITE_ prefix — exposed to browser) =====
VITE_SUPABASE_ANON_KEY=
VITE_TRPC_URL=/api/trpc

# ===== OPTIONAL =====
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
# VITE_FRONTEND_FORGE_API_KEY=
# VITE_FRONTEND_FORGE_API_URL=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# PORT=3000
