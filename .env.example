# Namibia Sports Platform — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.

# ===== DATABASE =====
# The Worker reaches Postgres through the HYPERDRIVE binding (see wrangler.jsonc),
# not DATABASE_URL. This value is still used by drizzle-kit migrations and as the
# Hyperdrive localConnectionString for `wrangler dev`.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ===== SUPABASE =====
# Server-side values are Worker vars/secrets — set with `wrangler secret put <NAME>`.
SUPABASE_URL=https://rbibqjgsnrueubrvyqps.supabase.co
VITE_SUPABASE_URL=https://rbibqjgsnrueubrvyqps.supabase.co
# Verifies caller JWTs and applies RLS as the caller. Required.
SUPABASE_ANON_KEY=
# Storage uploads only.
SUPABASE_SERVICE_ROLE_KEY=

# ===== AUTH =====
# Auth is Supabase Auth end to end: the client sends the Supabase access token as
# `Authorization: Bearer <token>` and the Worker verifies it. The former self-signed
# session JWT (JWT_SECRET / OAUTH_SERVER_URL / OWNER_OPEN_ID) has been removed.
# Roles live in sportsplatform_users.role; self-signup always yields 'user'.

# ===== AI =====
# Optional Phase 2 fallback for Content Sync + existing ai.* helpers.
# Phase 1 Content Sync uses the Workers AI binding (wrangler.jsonc ai.binding).
ANTHROPIC_API_KEY=
# Worker var — Content Sync admin procedures default ON. Set "false" to kill-switch.
# ENABLE_CONTENT_SYNC=false

# ===== WHATSAPP =====
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# For Supabase Edge Function whatsapp-webhook (Meta verification)
WHATSAPP_VERIFY_TOKEN=sports-platform-verify
# Worker var — must be "true" for whatsapp.subscribe (default off). Pair with
# VITE_SHOW_WHATSAPP_SUBSCRIBE; UI flag alone does not open the API.
# ENABLE_WHATSAPP_SUBSCRIBE=true

# ===== CLIENT (VITE_ prefix — exposed to browser) =====
VITE_SUPABASE_ANON_KEY=
VITE_TRPC_URL=/api/trpc

# ===== OPTIONAL =====
# Force-show Live in primary nav even with 0 live/scheduled streams (default: inventory-gated).
# VITE_SHOW_LIVE_NAV=true
# Show WhatsApp subscribe CTA on federation home (default: off — incomplete integration).
# VITE_SHOW_WHATSAPP_SUBSCRIBE=true
# Show floating AI chat assistant (default: off — incomplete integration; API also requires auth).
# VITE_SHOW_AI_CHAT=true
# Show "Continue with Google" on login/register (default: off — the Google
# provider is disabled on the shared Supabase project, so the button can only
# error. Enable the provider first, then set this).
# VITE_ENABLE_GOOGLE_AUTH=true
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
# VITE_FRONTEND_FORGE_API_KEY=
# VITE_FRONTEND_FORGE_API_URL=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# PORT=3000
