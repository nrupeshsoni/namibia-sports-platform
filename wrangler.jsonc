{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ────────────────────────────────────────────────────────────────────────────
  // Namibia Sports Platform — single Cloudflare Worker serving the SPA + API.
  // Target: the apex domain sports.com.na.
  //
  // NOTE: this is a FIRST production deployment. The app has never been live.
  // ────────────────────────────────────────────────────────────────────────────

  "name": "namibia-sports-platform",
  "main": "server/worker.ts",
  "account_id": "172d6c3857f7ef25ecc5caadc9381e9f",

  "compatibility_date": "2026-07-18",
  // nodejs_compat provides node:async_hooks (the request-scoped DB client uses
  // AsyncLocalStorage) plus the Node APIs postgres-js relies on.
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Paid plan allows 10,000 subrequests/invocation; raise the ceiling rather
  // than discover it under load. Deliberately NOT setting limits.cpu_ms —
  // that caps at 5 min and would only ever lower the default.
  "limits": { "subrequests": 50000 },

  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker runs first for API + static asset trees so we can:
    //   1) serve tRPC (not SPA HTML) on /api/*
    //   2) return real 404s for missing /sports|/logos|/athletes|/venues|/news assets
    // Requires wrangler >= 4.20 for the array form.
    "run_worker_first": [
      "/api/*",
      "/sports/*",
      "/logos/*",
      "/athletes/*",
      "/venues/*",
      "/news/*"
    ]
  },

  // Workers cannot open arbitrary TCP sockets, so Postgres is reached through
  // Hyperdrive rather than connecting postgres-js straight to Supabase.
  //
  // NOT YET CREATED — deliberately left as a placeholder. Creating it requires
  // embedding a Postgres connection string, and the current DATABASE_URL
  // password is the `postgres` SUPERUSER credential that is committed to a
  // public GitHub repo. Baking that into infrastructure would persist a known-
  // compromised credential.
  //
  // Do this instead, in order:
  //   1. Rotate the Postgres password.
  //   2. Create a least-privilege role scoped to the 13 sportsplatform_* tables
  //      (see docs — do NOT reuse the superuser; this DB is shared with 15+
  //      unrelated products totalling ~737 tables).
  //   3. wrangler hyperdrive create namibia-sports-db \
  //        --connection-string="postgres://<scoped-role>:<pw>@<host>:5432/postgres"
  //   4. Paste the returned id below.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "dbfcf635ad4a475ba991743b94a5d6a2",
      "localConnectionString": "<DATABASE_URL_FOR_LOCAL_DEV>"
    }
  ],

  // Apex Custom Domain. Bound 2026-07-19: Hyperdrive (dbfcf635…) is live and a
  // real DB query (federations.list) was verified through it on staging. The
  // apex was released from the dome-x Worker first (a custom domain binds to
  // only one Worker), so this add takes it over cleanly.
  "routes": [{ "pattern": "sports.com.na", "custom_domain": true }],

  // Workers AI — used by contentSync (admin research assist). No secret required;
  // usage bills to the Cloudflare account. Prefer this over Anthropic until
  // ANTHROPIC_API_KEY is set (Phase 2 fallback in server/services/contentSyncAi.ts).
  "ai": {
    "binding": "AI"
  },

  "vars": {
    "SUPABASE_URL": "https://rbibqjgsnrueubrvyqps.supabase.co"
    // ENABLE_CONTENT_SYNC defaults ON when unset. Set "false" to disable
    // admin contentSync.* procedures (UI still shows a disabled message).
    // ENABLE_CONTENT_SYNC: "false"
  },

  // ── Secrets (wrangler secret put <NAME>) ──
  //   SUPABASE_ANON_KEY          verifies caller JWTs; RLS evaluates as the user
  //   SUPABASE_SERVICE_ROLE_KEY  storage uploads only — never for normal reads
  //   ANTHROPIC_API_KEY          ai router + contentSync Phase 2 fallback
  //
  // Optional vars (wrangler.toml vars / dashboard — not secrets):
  //   ENABLE_WHATSAPP_SUBSCRIBE  "true" to accept whatsapp.subscribe (default off)
  //   ENABLE_CONTENT_SYNC        "false" to disable contentSync (default on)
  //
  // As with DOME X: SUPABASE_ANON_KEY must never hold a service-role key.
  // Doing so bypasses RLS silently, with no error surfaced anywhere.

  "env": {
    // Staging on workers.dev. `routes` is explicitly empty: environments
    // INHERIT the top-level routes, so once the apex Custom Domain above is
    // uncommented, a staging deploy would otherwise steal it from production.
    "staging": {
      "name": "namibia-sports-platform-staging",
      "workers_dev": true,
      "routes": [],
      "observability": { "enabled": true },
      "limits": { "subrequests": 50000 },
      "assets": {
        "directory": "./dist/public",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/sports/*",
          "/logos/*",
          "/athletes/*",
          "/venues/*",
          "/news/*"
        ]
      },
      // Same placeholder as production — staging needs its own Hyperdrive id
      // (or may share production's) before it can deploy again.
      //
      // The staging Worker currently live at
      //   https://namibia-sports-platform-staging.facilit8.workers.dev
      // was deployed with this block temporarily removed, purely to validate
      // the asset layer and _redirects rules (both confirmed working). Its API
      // routes will fail until a real Hyperdrive id is filled in here.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "dbfcf635ad4a475ba991743b94a5d6a2",
          "localConnectionString": "<DATABASE_URL_FOR_LOCAL_DEV>"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "vars": {
        "SUPABASE_URL": "https://rbibqjgsnrueubrvyqps.supabase.co"
      }
    }
  }
}
