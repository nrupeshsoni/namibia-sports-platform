<!doctype html><html lang="en"><head><meta charset="utf-8" name="viewport" content="width=device-width,initial-scale=1"><title>World Athletics | Live Results</title><meta name="description" content="Follow competition results of your favourite athletes and countries lives"><link href="https://fonts.googleapis.com/css?family=Roboto+Condensed:300,400,400i,700,700i&display=swap" rel="stylesheet"><script src="/config.js"></script><script>if (/msie\ [0-9]{1}/i.test(navigator.userAgent)) {
