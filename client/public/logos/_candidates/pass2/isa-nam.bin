document.addEventListener("DOMContentLoaded", function () {
    const pumDiv = document.getElementById("pum-28924");

    if (pumDiv) {

        pumDiv.addEventListener("click", function (event) {
            console.log("Click detected on:", event.target);

            // Check if the clicked element is the div itself or a button inside it
            if (event.target === pumDiv) {
                console.log("Clicked on the div itself. Removing div.");
                pumDiv.remove();
            } else if (event.target.tagName === "BUTTON") {
                console.log("Clicked on a button inside the div. Removing div.");
                pumDiv.remove();
            }
        });
    } else {
    }
});
</script>

